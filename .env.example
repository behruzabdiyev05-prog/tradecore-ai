# ─────────────────────────────────────────────────────────────
# TRADECORE AI — environment variables
# Copy to `.env` for local development. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── Frontend (PUBLIC — bundled into the browser) ─────────────
# Only values that are safe to expose. The Supabase anon key is
# public by design; data is protected by Row Level Security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# ── Server-side ONLY (Netlify → Site settings → Environment) ─
# Used by Netlify Functions. Never prefix these with VITE_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# ARES AI provider (Phase 6). Leave empty until then — ARES will
# report "not configured" instead of producing answers.
ARES_PROVIDER=
ARES_PROVIDER_API_KEY=
